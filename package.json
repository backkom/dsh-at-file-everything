{
  "name": "dsh-at-file-everything",
  "version": "0.1.3",
  "description": "Everything-backed @file completion for DeepSeek Harness on Windows: instant path search through es.exe, with the agent workspace as the ranking root",
  "icon": "assets/icon-180.png",
  "license": "MIT",
  "author": "leaf",
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./config": {
      "default": "./lib/config.js"
    },
    "./pure": {
      "default": "./lib/pure.js"
    },
    "./tool": {
      "default": "./lib/tool.js"
    },
    "./client": {
      "default": "./lib/client.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "everything",
    "es.exe",
    "file-reference",
    "autocomplete",
    "find-files",
    "windows"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run typecheck && npm run build && npm run test",
    "verify:activate": "node scripts/verify-activation.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.0.5-0 || >=4.0.5-alpha.1 <4.1.0-0 || >=4.1.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-file-reference": ">=0.1.5-rc.3 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <3.18.5-0 || >=3.18.5-alpha.1 <3.19.0-0 || >=3.19.0-rc.1 <4.0.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backkom/dsh-at-file-everything.git"
  },
  "homepage": "https://github.com/backkom/dsh-at-file-everything",
  "bugs": {
    "url": "https://github.com/backkom/dsh-at-file-everything/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
